# Backend configuration example. Never put real credentials here.
# DATABASE_URL will use SQLAlchemy's postgresql+psycopg:// scheme.
# Missing URL: /api/v1/health returns 200; /api/v1/ready returns 503.
# Remote URLs require sslmode=verify-full and sslrootcert=<absolute CA file path>.
# Render's certificate path is /etc/secrets/supabase-ca.crt.
# Use a restricted application role; percent-encode reserved password characters.
DATABASE_URL=

DB_POOL_SIZE=2
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READINESS_TIMEOUT_SECONDS=8
# Optional in-process cleanup of expired limiters, Google attempts and local sessions.
# One batch per table, serially, after each interval while FastAPI is running.
# Batch size and timeout apply separately to each table.
# Defaults: at most 400 rows per pass and four five-second deadlines.
# Connection cleanup may outlast deadlines. Active sessions/profiles are preserved.
# Guest-history retention must be reviewed before adding guest-owned chats/vehicles.
AUTH_RATE_LIMIT_CLEANUP_ENABLED=false
AUTH_RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=300
AUTH_RATE_LIMIT_CLEANUP_BATCH_SIZE=100
AUTH_RATE_LIMIT_CLEANUP_TIMEOUT_SECONDS=5
# Used only by Alembic, with a separate migration-role credential.
# Do not configure this credential on the running Render web service.
MIGRATION_DATABASE_URL=
GUEST_SESSION_INACTIVITY_DAYS=30

# Optional integration tests only: local mazda6_admin credentials for askm6_test.
# Required target: 127.0.0.1:15432/askm6_test; no URL query parameters.
# Keep the real URL in an ignored .env.integration.local file, not on Render.
TEST_DATABASE_URL=
# Set false only for local HTTP development.
GUEST_COOKIE_SECURE=true
# Exact browser origins, expressed as a JSON array. No trailing slash.
CSRF_TRUSTED_ORIGINS=["https://askm6.com"]
# Keep disabled until frontend challenge integration and abuse controls are ready.
GUEST_SESSION_API_ENABLED=false
# Total guest-session operation deadline, in seconds (1–30).
GUEST_SESSION_TIMEOUT_SECONDS=15
# New-session attempts only; active-session reuse does not consume this budget.
# Requires migrated runtime DB and AUTH_RATE_LIMIT_HMAC_SECRET.
GUEST_CREATION_IP_MAX_REQUESTS=10
GUEST_CREATION_IP_WINDOW_SECONDS=600

# Managed account-token verification.
# Use the project's Auth issuer, without a trailing slash.
SUPABASE_AUTH_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_AUTH_AUDIENCE=authenticated
# Small issuer/app clock difference for iat only (0–30 seconds).
# Expiry and not-before validation remain strict.
SUPABASE_AUTH_IAT_CLOCK_SKEW_SECONDS=5

# Account-session expiry and cookie security.
ACCOUNT_SESSION_INACTIVITY_DAYS=7
ACCOUNT_SESSION_ABSOLUTE_LIFETIME_DAYS=30
# Set false only for local HTTP development.
ACCOUNT_COOKIE_SECURE=true

# Required for server-managed account sessions; leave empty when disabled.
# Backend-only Fernet key; keep the real value in an ignored environment file.
ACCOUNT_SESSION_ENCRYPTION_KEY=

# Required for provider authentication and refresh requests.
# Use the project's sb_publishable_... key.
SUPABASE_AUTH_PUBLISHABLE_KEY=

# Keep disabled until abuse controls and deployment checks are ready.
ACCOUNT_SESSION_API_ENABLED=false
ACCOUNT_SESSION_AUTH_TIMEOUT_SECONDS=15

# Account sign-in also requires CAPTCHA protection enabled in Supabase Auth.
# Configure its CAPTCHA secret there; supply a fresh captcha_token per attempt.
# Keep disabled until remaining abuse controls and deployment checks are ready.
ACCOUNT_SIGN_IN_API_ENABLED=false

# Total sign-in operation deadline, in seconds (1–30).
ACCOUNT_SIGN_IN_TIMEOUT_SECONDS=15

# Enforced when sign-in is enabled; requires migrated runtime DB and HMAC secret.
ACCOUNT_SIGN_IN_IP_MAX_REQUESTS=30
ACCOUNT_SIGN_IN_IP_WINDOW_SECONDS=600

# Keep disabled until endpoint testing and deployment checks are complete.
ACCOUNT_SIGN_OUT_API_ENABLED=false
ACCOUNT_SIGN_OUT_TIMEOUT_SECONDS=15

# Explicit Terms acceptance; keep disabled until the migration and deployment checks pass.
# Reuses ACCOUNT_SESSION_AUTH_TIMEOUT_SECONDS for parsing, authentication and commit.
ACCOUNT_TERMS_API_ENABLED=false

# Registration requires Supabase email confirmation and CAPTCHA protection.
# Also requires ACCOUNT_TERMS_API_ENABLED and ACCOUNT_SESSION_ENCRYPTION_KEY.
# Keep disabled until the complete registration flow is verified for this deployment.
ACCOUNT_SIGN_UP_API_ENABLED=false
ACCOUNT_SIGN_UP_TIMEOUT_SECONDS=15
# Configurable starting policy; enforced with migrated runtime DB and HMAC secret.
ACCOUNT_SIGN_UP_IP_MAX_REQUESTS=10
ACCOUNT_SIGN_UP_IP_WINDOW_SECONDS=600

# Keep disabled while email confirmation is being implemented and tested.
ACCOUNT_EMAIL_CONFIRMATION_API_ENABLED=false
ACCOUNT_EMAIL_CONFIRMATION_TIMEOUT_SECONDS=15
# Independent IP budget; requires migrated runtime DB and fingerprint secret.
ACCOUNT_EMAIL_CONFIRMATION_IP_MAX_REQUESTS=10
ACCOUNT_EMAIL_CONFIRMATION_IP_WINDOW_SECONDS=600

# Keep disabled while password recovery is being implemented and tested.
ACCOUNT_PASSWORD_RECOVERY_API_ENABLED=false
# Total recovery-request deadline, in seconds (1–30).
ACCOUNT_PASSWORD_RECOVERY_TIMEOUT_SECONDS=15
# Enforced when the recovery endpoint is enabled; requires migrated runtime DB.
ACCOUNT_PASSWORD_RECOVERY_IP_MAX_REQUESTS=10
ACCOUNT_PASSWORD_RECOVERY_IP_WINDOW_SECONDS=600

# Required for enabled recovery/sign-in/sign-up/confirmation/reset/guest creation/Google start.
# Exactly 64 hexadecimal characters encoding 32 randomly generated bytes.
AUTH_RATE_LIMIT_HMAC_SECRET=

# Off locally. Hosted limiter IPs require a matching server-only Pages assertion.
# Use a separate random 32-byte key (64 hex characters), never a VITE_* variable.
# Enable only after the Pages ingress and HTTPS backend path have been verified.
AUTH_PROXY_TRUST_ENABLED=false
AUTH_PROXY_SHARED_SECRET=

# Keep disabled until the complete reset flow is validated.
ACCOUNT_PASSWORD_RESET_API_ENABLED=false
# Total password-reset operation deadline, in seconds (1–30).
ACCOUNT_PASSWORD_RESET_TIMEOUT_SECONDS=15
# Separate from recovery-email requests; requires migrated runtime DB and fingerprint secret.
ACCOUNT_PASSWORD_RESET_IP_MAX_REQUESTS=10
ACCOUNT_PASSWORD_RESET_IP_WINDOW_SECONDS=600

# Keep disabled until Google OAuth and callback validation are complete.
ACCOUNT_GOOGLE_OAUTH_API_ENABLED=false
# Separate initiation/replacement budget; requires migrated DB and fingerprint secret.
ACCOUNT_GOOGLE_OAUTH_IP_MAX_REQUESTS=10
ACCOUNT_GOOGLE_OAUTH_IP_WINDOW_SECONDS=600
# Total backend operation deadline; excludes time spent on Google's pages (1–30 seconds).
ACCOUNT_GOOGLE_OAUTH_TIMEOUT_SECONDS=15
# Pending Google login lifetime, including time on Google's pages (60–900 seconds).
ACCOUNT_GOOGLE_OAUTH_ATTEMPT_LIFETIME_SECONDS=600
# Exact public callback; leave unset until the complete Google flow is configured and validated.
# HTTPS is required, except loopback HTTP when ACCOUNT_COOKIE_SECURE=false.
# Local example: http://127.0.0.1:5173/api/v1/account/google/callback
# Production example: https://askm6.com/api/v1/account/google/callback
ACCOUNT_GOOGLE_OAUTH_CALLBACK_URL=

# Guest-session Siteverify secret; account CAPTCHA is configured in Supabase Auth.
# Backend-only Turnstile secret. Never expose this in frontend variables.
TURNSTILE_SECRET_KEY=

# Exact frontend hostnames as a JSON array.
# No scheme, port, path, or wildcard.
TURNSTILE_ALLOWED_HOSTNAMES=["askm6.com"]

# Total Siteverify request deadline, in seconds (1–30).
TURNSTILE_TIMEOUT_SECONDS=5
