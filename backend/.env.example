# Backend configuration example. Never put real credentials here.
# DATABASE_URL will use SQLAlchemy's postgresql+psycopg:// scheme.
# Missing URL: /api/v1/health returns 200; /api/v1/ready returns 503.
# Remote URLs require sslmode=verify-full and sslrootcert=<absolute CA file path>.
# Render's certificate path is /etc/secrets/supabase-ca.crt.
# Use a restricted application role; percent-encode reserved password characters.
DATABASE_URL=

DB_POOL_SIZE=2
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READINESS_TIMEOUT_SECONDS=8
