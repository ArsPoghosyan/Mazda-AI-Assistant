# Public Turnstile site key used by the browser.
# Never put the Turnstile secret key in frontend configuration.
VITE_TURNSTILE_SITE_KEY=

# Production guest-session access; independent of account sign-in switches.
# Only exact true enables it. Requires GUEST_SESSION_API_ENABLED on the backend,
# GUEST_SESSION_PROXY_ENABLED on Pages and a real public Turnstile site key.
# Rebuild after changing this flag. Chat remains in development.
VITE_GUEST_ACCESS_ENABLED=false

# Build-time switch for production email sign-in, session restoration and sign-out.
# Only the exact value true enables it; development remains enabled independently.
# Requires the corresponding backend/proxy gates, Terms endpoints and real site key.
# Registration, Google, recovery/reset and guest access each have separate flags.
VITE_ACCOUNT_AUTH_ENABLED=false

# Production sign-up and email-code confirmation; also requires the account flag above.
# Keep false until both backend/proxy routes and Terms receipt flow are ready.
# Confirmation never signs in automatically. Rebuild after changing this public flag.
VITE_ACCOUNT_REGISTRATION_ENABLED=false

# Production recovery email and code-based password reset; also requires the account flag.
# Keep false until both backend/proxy routes and the recovery email template are ready.
# Reset requires a separate sign-in. Rebuild after changing this public flag.
VITE_ACCOUNT_RECOVERY_ENABLED=false

# Google requires this flag and a valid public issuer in development.
# Production additionally requires VITE_ACCOUNT_AUTH_ENABLED=true; both flags are build-time.
# Enable only after the Google backend and start/callback proxies are ready.
VITE_GOOGLE_OAUTH_ENABLED=false

# Public Supabase issuer URL, never a secret or service-role key.
VITE_SUPABASE_AUTH_ISSUER=
