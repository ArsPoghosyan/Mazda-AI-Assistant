# Public Turnstile site key used by the browser.
# Never put the Turnstile secret key in frontend configuration.
VITE_TURNSTILE_SITE_KEY=

# Keep disabled until the complete Google flow is validated.
VITE_GOOGLE_OAUTH_ENABLED=false

# Public Supabase issuer URL, never a secret or service-role key.
VITE_SUPABASE_AUTH_ISSUER=